page { background: #101010; }
.page { min-height: 100vh; padding: 30rpx; background: #101010; color: #d8d8d8; }
.tv-shell { display: grid; grid-template-columns: minmax(0, 1fr) 260rpx; gap: 30rpx; max-width: 1180rpx; margin: auto; padding: 34rpx 34rpx 70rpx; border-radius: 28rpx; background: linear-gradient(145deg, #424242, #1f1f1f 68%, #151515); box-shadow: inset 0 2rpx 2rpx rgba(255,255,255,.22), inset 0 -18rpx 30rpx rgba(0,0,0,.45); }
.screen { position: relative; height: 720rpx; overflow: hidden; padding: 18rpx; border: 3rpx solid #090909; border-radius: 16rpx; background: repeating-linear-gradient(0deg, rgba(0,0,0,.045) 0, rgba(0,0,0,.045) 1rpx, transparent 1rpx, transparent 6rpx), radial-gradient(circle at 50% 18%, #f3f3f3, #c9c9c9 58%, #9f9f9f); box-shadow: inset 0 0 48rpx rgba(0,0,0,.38); color: #2f2f2f; }
.screen-head, .screen-foot { display: flex; justify-content: space-between; font-family: monospace; font-size: 24rpx; letter-spacing: 2rpx; }
.status { color: #5f5f5f; }.status.active { color: #2da84a; }
.tv-text { position: absolute; top: 68rpx; right: 18rpx; bottom: 58rpx; left: 18rpx; width: auto; height: auto; padding: 0 10rpx; color: #2a2a2a; font-size: 32rpx; line-height: 1.65; }
.screen-foot { position: absolute; right: 18rpx; bottom: 16rpx; left: 18rpx; color: #777; font-size: 20rpx; }
.brand { margin-top: 24rpx; font-size: 40rpx; font-weight: 700; letter-spacing: 8rpx; }.access { margin-top: 10rpx; color: #999; font-family: monospace; font-size: 20rpx; letter-spacing: 1rpx; }
.panel { display: flex; flex-direction: column; gap: 24rpx; }.speaker { height: 94rpx; border-radius: 12rpx; background: radial-gradient(#050505 1.5rpx, transparent 2rpx) 0 0 / 8rpx 8rpx, linear-gradient(#222, #111); box-shadow: inset 0 0 18rpx rgba(0,0,0,.8); }
.panel-label { font-family: monospace; font-size: 22rpx; letter-spacing: 2rpx; }.password { height: 70rpx; padding: 0 14rpx; border: 1rpx solid #4a4a4a; border-radius: 8rpx; background: #101010; color: #e8e8e8; font-size: 24rpx; }
.knobs, .buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.knob { height: 142rpx; padding: 12rpx 0 0; border: 0; background: transparent; color: #aaa; font-size: 24rpx; }.knob view { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin: 0 auto 8rpx; border-radius: 50%; background: radial-gradient(circle at 36% 28%, #555, #262626 58%, #151515); box-shadow: inset 0 8rpx 12rpx rgba(255,255,255,.08), 0 8rpx 12rpx rgba(0,0,0,.5); }.knob text { color: #666; font-family: monospace; font-size: 18rpx; }
.buttons { grid-template-columns: repeat(3, 1fr); }.buttons button { padding: 0; border-radius: 8rpx; background: linear-gradient(#666, #242424); color: #f1f1f1; font-size: 21rpx; line-height: 62rpx; box-shadow: inset 0 1rpx 1rpx rgba(255,255,255,.35), 0 4rpx 8rpx rgba(0,0,0,.55); }
@media (max-width: 650px) { .page { padding: 20rpx; }.tv-shell { display: block; padding: 22rpx; }.screen { height: 560rpx; }.panel { margin-top: 30rpx; }.brand { font-size: 34rpx; } }
